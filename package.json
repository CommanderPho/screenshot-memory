{
  "name": "screenshot-memory",
  "version": "1.0.0",
  "description": "Find any screenshot by what's IN it. Semantic search for your screenshots.",
  "keywords": [
    "screenshot",
    "ocr",
    "search",
    "semantic-search",
    "memvid",
    "cli",
    "terminal",
    "image-search",
    "text-extraction"
  ],
  "author": "Memvid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/memvid/screenshot-memory"
  },
  "homepage": "https://github.com/memvid/screenshot-memory#readme",
  "bugs": {
    "url": "https://github.com/memvid/screenshot-memory/issues"
  },
  "bin": {
    "screenshot-memory": "./bin/ssm",
    "ssm": "./bin/ssm"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/cli.ts",
    "start": "bun run dist/cli.js",
    "start:node": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@memvid/sdk": "^2.0.151",
    "tesseract.js": "^5.1.0",
    "sharp": "^0.33.5",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "cli-progress": "^3.12.0",
    "chokidar": "^3.6.0",
    "glob": "^10.4.0",
    "p-limit": "^6.1.0",
    "date-fns": "^3.6.0",
    "inquirer": "^9.3.0",
    "boxen": "^7.1.0",
    "figures": "^6.1.0",
    "env-paths": "^3.0.0",
    "conf": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0",
    "@types/cli-progress": "^3.11.6",
    "vitest": "^2.0.0"
  }
}
